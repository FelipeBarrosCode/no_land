spawn ssh -o StrictHostKeyChecking=no -p 57906 -i ~/vastai root@184.144.255.144 "sed -i -e 's|Environment=NOLAND_STATE_ROOT|Environment=NOLAND_HOME=/home/user\\nEnvironment=NOLAND_STATE_ROOT|' /etc/systemd/system/noland-state-agent.service && systemctl daemon-reload"
