#!/usr/bin/expect -f
set timeout 10
spawn ssh -o StrictHostKeyChecking=no -p 57906 -i ~/vastai root@184.144.255.144 "cat << 'INNER_EOF' > /home/user/.local/share/applications/sklauncher.desktop
\[Desktop Entry\]
Name=SKlauncher
Exec=java -jar /home/user/Downloads/SKlauncher-3.2.18.jar
Type=Application
Categories=Game;
INNER_EOF
chown user:user /home/user/.local/share/applications/sklauncher.desktop"
expect {
    "Enter passphrase for key" {
        send_user "SSH key is not loaded. Run: ssh-add ~/vastai\n"
        exit 1
    }
    eof
}
