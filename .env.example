# macOS code signing inputs for local builds
# APPLE_CERT_P12 can be either a base64-encoded .p12 payload or a path to a .p12 file.
APPLE_CERT_P12=
APPLE_CERT_PASSWORD=
APPLE_TEAM_ID=

# Optional notarization inputs.
# For local builds, point APPLE_API_KEY_PATH at AuthKey_<KEY_ID>.p8.
# In CI, you can provide the key contents directly via APPLE_API_KEY_CONTENT instead.
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=
APPLE_API_KEY_CONTENT=
