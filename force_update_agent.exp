#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no -p 61761 -i ~/vastai root@142.170.96.180 "systemctl stop noland-state-agent && rm -f /run/noland/state-agent.sock"
expect {
    "Enter passphrase for key" {
        send_user "SSH key is not loaded. Run: ssh-add ~/vastai\n"
        exit 1
    }
    eof
}
