#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no -p 57906 -i ~/vastai root@184.144.255.144 "curl -s --unix-socket /run/noland/state-agent.sock http://localhost/rpc -H 'Content-Type: application/json' -d '{\"id\": \"1\", \"method\": \"ListApps\", \"params\": {}}'"
expect {
    "Enter passphrase for key" {
        send_user "SSH key is not loaded. Run: ssh-add ~/vastai\n"
        exit 1
    }
    eof
}
