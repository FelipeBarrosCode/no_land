#!/usr/bin/expect -f
set timeout 10
spawn ssh -o StrictHostKeyChecking=no -p 57906 -i ~/vastai root@184.144.255.144 "chown user: /home/user/.local/share/applications/sklauncher.desktop"
expect {
    "Enter passphrase for key" {
        send_user "SSH key is not loaded. Run: ssh-add ~/vastai\n"
        exit 1
    }
    eof
}
