# Force LF line endings for files that run on Linux VMs or are embedded into
# the app binary at compile time. Windows checkouts (core.autocrlf=true) would
# otherwise check these out as CRLF, which breaks remote bash execution
# (`set: pipefail : invalid option name`).
*.sh text eol=lf
*.exp text eol=lf
*.service text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# CI regression fixtures parse source/config text on all six hosted targets.
# Keep PowerShell checkouts identical to the Linux/macOS workflow inputs.
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
