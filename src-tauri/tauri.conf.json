{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noland Connect",
  "version": "0.1.0",
  "identifier": "com.noland.connect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noland Connect",
        "width": 1400,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/noland-net-helper",
      "binaries/noland-mic-sender"
    ],
    "resources": [

      "binaries/ssh-*",
      "binaries/scp-*",
      "binaries/ssh-keygen-*",
      "binaries/ssh-runtime/**/*",
      "binaries/gstreamer/**/*",
      "../vm-cloud-mic-agent/Cargo.toml",
      "../vm-cloud-mic-agent/src/**/*",
      "../state-agent/Cargo.toml",
      "../state-agent/Cargo.lock",
      "../state-agent/rust-toolchain.toml",
      "../state-agent/crates/**/*",
      "../state-agent/scripts/**/*",
      "../state-agent/systemd/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": [
        "bundled/macos/GStreamer.framework"
      ]
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
