{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noland Connect",
  "version": "0.1.0",
  "identifier": "com.noland.connect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noland Connect",
        "width": 1400,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
